#!/bin/bash

site=`basename $PWD`

if [ "$#" -ne 2 ]; then
    cat <<EOF

Usage: `basename $0` <host> <path>

    host - sftp-accessible host (bare alias from ~/.ssh/config, or an sftp:// URL)
    path - path to the root of the website on the remote server

EOF
    exit 1
fi

host=$1
remotewebroot=$2

if ! command -v lftp >/dev/null 2>&1; then
    echo "Reminder: this script needs lftp. Install with: brew install lftp" >&2
fi

# lftp treats a bare hostname as ftp://, so force sftp:// when not given.
if [[ "$host" == sftp://* ]]; then
    url="$host"
else
    url="sftp://$host"
fi

# Akeeba lives in com_akeeba (J3) or com_akeebabackup (J4) — probe both.
remotedir=""
for candidate in \
    "$remotewebroot/administrator/components/com_akeeba/backup" \
    "$remotewebroot/administrator/components/com_akeebabackup/backup"; do
    if lftp -c "open \"$url\"; cd \"$candidate\"" >/dev/null 2>&1; then
        remotedir="$candidate"
        break
    fi
done

if [ -z "$remotedir" ]; then
    echo "Could not access a remote backup directory"
    exit 1
fi

# cls -t sorts newest first; pick the latest .jpa as the active backup set.
latest=$(lftp -c "open \"$url\"; cd \"$remotedir\"; cls -1 -t site*.jpa" 2>/dev/null | head -1)

if [ -z "$latest" ]; then
    echo "Could not find any backup files in $remotedir"
    exit 1
fi

basename_no_ext="${latest%.jpa}"

echo "Latest backup on remote: $remotedir/$latest"

# --ignore-time: skip files whose local size already matches (Akeeba filenames
# are unique per backup, so size collisions across versions don't happen).
# Default mirror compares size AND mtime, which forces a redownload whenever
# the local mtime drifts (e.g. touched after a previous restore).
# --continue resumes partial transfers instead of restarting from zero.
lftp -c "
    open \"$url\";
    mirror --verbose --no-recursion --ignore-time --continue \
        --include-glob \"${basename_no_ext}.jpa\" \
        --include-glob \"${basename_no_ext}.j[0-9][0-9]\" \
        \"$remotedir\" .
"

if [ $? -ne 0 ]; then
    echo "Download failed"
    exit 1
fi
